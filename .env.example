PENPOT_VERSION=2.18.3
PENPOT_PUBLIC_URI=http://localhost:8080
SIGMA_SITE_ADDRESS=:80
SIGMA_HTTP_PORT=8080
SIGMA_HTTPS_PORT=8443
ACME_EMAIL=admin@example.com
PENPOT_FLAGS=disable-email-verification enable-smtp disable-secure-session-cookies enable-mcp enable-login-with-password enable-registration disable-telemetry
PENPOT_SECRET_KEY=
POSTGRES_PASSWORD=
COMPOSE_PROFILES=local
SMTP_HOST=penpot-mailcatch
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_TLS=false
SMTP_SSL=false
SMTP_DEFAULT_FROM=no-reply@localhost
SMTP_DEFAULT_REPLY_TO=no-reply@localhost
# Optional AI configuration. Model ID is deliberately not guessed.
AI_PROVIDER=openai-compatible
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=
AI_API_KEY=
AI_ALLOW_HTTP=false
AI_REQUESTS_PER_HOUR=20
AI_MAX_CONCURRENT=2
# A separate, revocable AI spending token for each teammate. Not a Penpot/MCP key.
SIGMA_AI_USERS='{}'

# Sigma Headless MCP (apps/mcp-headless)
SIGMA_AGENT_EMAIL=sigma-agent@sigma.local
SIGMA_AGENT_PASSWORD=
SIGMA_AGENT_TOKEN=
SIGMA_MCP_KEY=
SIGMA_MCP_BIND=100.64.0.0
